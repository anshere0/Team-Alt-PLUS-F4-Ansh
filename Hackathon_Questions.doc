<title>Hackathon Pitch Q&A</title>
<style>
  body { font-family: 'Calibri', sans-serif; font-size: 12pt; }
  h1 { font-size: 18pt; color: #2F5496; }
  h2 { font-size: 16pt; color: #2F5496; margin-top: 20px; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
  h3 { font-size: 14pt; color: #2F5496; margin-bottom: 4px; }
  p { margin-top: 2px; line-height: 1.5; }
</style>
