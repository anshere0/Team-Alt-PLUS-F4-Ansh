# ==========================================
# DOMAIN A: FRONTEND CONFIGURATION
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/alerts
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ==========================================
# DOMAIN B: BACKEND CONFIGURATION
# ==========================================
PROJECT_NAME="GridGuard Backend"
SECRET_KEY=gridguard-hackathon-super-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/gridguard_db
REDIS_URL=redis://localhost:6379/0
AI_SERVICE_URL=http://localhost:8001
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
PORT=8000

# ==========================================
# DOMAIN C: AI CONFIGURATION
# ==========================================
MODEL_WEIGHTS_DIR=./aiml/weights
ENABLE_REALTIME_INFERENCE=true
SHAP_BACKGROUND_SAMPLES=50
MODEL_PATH=./weights/model.pt
MODEL_VERSION=v1.0.0
LOG_LEVEL=INFO

# ==========================================
# DOMAIN D: PLATFORM CONFIGURATION
# ==========================================
DOCKER_TAG=latest
DEPLOY_ENV=development
CI_TOKEN=your_ci_token_here
ENVIRONMENT=development
PORT_FRONTEND=3000
PORT_BACKEND=8000
PORT_AI=8001
PORT_DATABASE=5432
